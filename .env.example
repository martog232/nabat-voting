# Copy to .env for local Docker Compose runs

# REQUIRED. Must be the SAME value nabat-app uses, or the access tokens it mints
# will not validate here. Generate once and share between both services:
#
#     openssl rand -base64 48
#
# Left blank deliberately — the service refuses to start rather than fall back to
# a placeholder key (see JwtTokenProvider).
JWT_SECRET=

POSTGRES_HOST_PORT=5434
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5434/nabat_voting_db
SPRING_DATASOURCE_USERNAME=nabat_voting_user
SPRING_DATASOURCE_PASSWORD=nabat_voting_password
SERVER_PORT=8081
# Host-side tooling connects through Kafka's EXTERNAL listener on 29092.
# Inside docker-compose the app uses kafka:9092 (set in the compose file).
SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
